
{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "pages/**/*.ts",
    "steps/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "test-results",
    ".features-gen"
  ]
}
